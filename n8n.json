{
  "nodes": [
    {
      "id": "Set_Jailbreak_Fields",
      "name": "Extract Jailbreak Fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        800,
        350
      ],
      "parameters": {
        "keepOnlySet": false,
        "values": {
          "boolean": [
            {
              "name": "jailbreak_detected",
              "value": "={{ $json.output.has_jailbreak }}"
            }
          ],
          "string": [
            {
              "name": "comment",
              "value": "={{ $json.output.clean_comment }}"
            },
            {
              "name": "jailbreak_message",
              "value": "={{ $json.output.jailbreak_instructions }}"
            }
          ],
          "json": [
            {
              "name": "jailbreak_raw",
              "value": "={{ $json.output }}"
            }
          ]
        }
      }
    }
  ],
  "connections": {}
}
