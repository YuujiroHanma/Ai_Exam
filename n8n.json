    {
      "parameters": {
        "model": "gpt-4o-mini",
        "operation": "chat",
        "systemMessage": "You receive a receipt image and comment. Extract JSON with:\nmerchant, receipt_date, amount, currency,\ncategory, contains_alcohol, contains_cigarettes,\nis_out_of_town_travel, is_training_related_to_job,\ndescription. No explanation."
      },
      "id": "VisionOCR",
      "name": "AI Vision - OCR and Extraction",
      "type": "n8n-nodes-base.openai",
      "typeVersion": 2,
      "position": [1290, 240]
    },
    {
      "parameters": {
        "functionCode": "const e = $json;\n\nlet status = 'manual_review';\nlet reason = 'Policy 8: manual';\nlet policy_code = 'P8';\nconst amount = Number(e.amount || 0);\nconst cat = e.category;\n\nfunction reject(r,c){status='rejected';reason=r;policy_code=c;}\nfunction approve(r,c){status='approved';reason=r;policy_code=c;}\nfunction manual(r,c){status='manual_review';reason=r;policy_code=c;}\n\nif(cat==='cigarettes'||e.contains_cigarettes){reject('Policy3: cigarettes not allowed','P3');}\nelse if(cat==='training'&&e.is_training_related_to_job){approve('Policy7: training auto-approved','P7');}\nelse if(cat==='it_equipment'){\n if(amount<=600)approve('Policy6: up to 600','P6');\n else reject('Policy6: above 600 reject','P6');\n}\nelse if(cat==='food'){\n if(e.contains_alcohol)reject('Policy1: alcohol not allowed','P1');\n else if(amount<=50)approve('Policy1: food ok','P1');\n else manual('Policy1: >50 manual','P1');\n}\nelse if(cat==='business_meal'){\n if(amount<=400)approve('Policy2 ok','P2');\n else manual('Policy2: >400 manual','P2');\n}\nelse if(cat==='transport_city'||cat==='taxi'){\n if(amount<=30)approve('Policy4 ok','P4');\n else reject('Policy4 above 30 reject','P4');\n}\nelse if(cat==='travel_out_of_town'||e.is_out_of_town_travel)manual('Policy5 manual','P5');\n\nreturn [{json:{...e,status,status_reason:reason,policy_code}}];"
      },
      "id": "ApplyPolicies",
      "name": "Function - Apply Policies",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
