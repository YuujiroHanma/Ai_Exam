    {
      "parameters": {
        "functionCode": "const rows = items.map(e=>e.json);\nlet total=0;\nconst by_category={};\nconst by_status={};\nfor(const r of rows){\n const amt=Number(r.amount||0);\n total+=amt;\n by_category[r.category]=(by_category[r.category]||0)+amt;\n by_status[r.status]=(by_status[r.status]||0)+amt;\n}\nreturn [{json:{total_amount:total,by_category,by_status,expenses:rows}}];"
      },
