    {
      "parameters": {
        "jsCode": "const expense = items[0].json\n\nlet status = \"needs_manual_review\";\nlet reason = \"\";\nconst amount = expense.amount || 0;\n\n// Policy 3\nif (expense.contains_cigarettes) {\n  status = \"declined\";\n  reason = \"Cigarettes are not approved.\";\n}\n// Policy 5\nelse if (expense.is_out_of_town_travel) {\n  status = \"needs_manual_review\";\n  reason = \"Out of town travel requires manual review.\";\n}\n// Policy 7\nelse if (expense.is_training_related_to_job) {\n  status = \"approved\";\n  reason = \"Training related.\";\n}\n// Food\nelse if (expense.category === \"food\") {\n  if (expense.contains_alcohol) {\n    status = \"declined\";\n    reason = \"Alcohol not allowed for food.\";\n  } else if (amount <= 50) {\n    status = \"approved\";\n    reason = \"Food under limit.\";\n  } else {\n    status = \"needs_manual_review\";\n    reason = \"Food above limit.\";\n  }\n}\n// Business meals\nelse if (expense.category === \"business_meal\") {\n  if (amount <= 400) {\n    status = \"approved\";\n    reason = \"Business meal under limit.\";\n  } else {\n    status = \"needs_manual_review\";\n    reason = \"Business meal above limit.\";\n  }\n}\n// Transport (city + taxi)\nelse if (expense.category === \"transport\") {\n  if (amount <= 30) {\n    status = \"approved\";\n    reason = \"Transport under limit.\";\n  } else {\n    status = \"declined\";\n    reason = \"Transport above limit.\";\n  }\n}\n// Equipment\nelse if (expense.category === \"equipment\") {\n  if (amount <= 600) {\n    status = \"approved\";\n    reason = \"Equipment under limit.\";\n  } else {\n    status = \"declined\";\n    reason = \"Equipment above limit.\";\n  }\n}\n// Everything else → manual review\nelse {\n  status = \"needs_manual_review\";\n  reason = \"Other category requires review.\";\n}\n\nreturn [{\n  json: {\n    ...expense,\n    status,\n    reason\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        128,
        32
      ],
      "id": "0bbb6dd4-c487-4a00-a388-dc9ce2a2842b",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "// Взимаме текущия item\nconst item = items[0].json;\n\n// 1) Вземаме текста от `output`\nlet raw = item.output;\n\n// 2) Премахваме ```json и ``` ако ги има\nif (typeof raw === 'string') {\n  raw = raw.replace(/```json/i, '')\n           .replace(/```/g, '')\n           .trim();\n}\n\n// 3) Парсваме към обект\nlet expense = {};\ntry {\n  expense = JSON.parse(raw);\n} catch (error) {\n  throw new Error('Не мога да parse-на output като JSON: ' + error.message);\n}\n\n// 4) Добавяме status и reason към обекта, за да ги вкараме в таблицата\nexpense.status = item.status;\nexpense.reason = item.reason;\n\n// 5) Връщаме коригираните данни\nreturn [\n  {\n    json: expense\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
